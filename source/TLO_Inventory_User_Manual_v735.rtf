# Full inventory\line  tlo-gi.exe --TLOHome C:\\TLOHome --search-path "[Archive]E:\\Music" --compliant\line  python3 tlo-gi.py --TLOHome "$TLOHome" --etree-lookup --setlistfm-lookup\line \line # Standalone tagger\line  tlo-tag.exe --TLOHome C:\\TLOHome --tag-path E:\\ReadyToTag --etree-lookup --setlistfm-lookup --setlistfm-upgrade --thorough-setlist-matching --corrupt-files keep --corrupt-folders threshold --corrupt-folder-threshold 25 --delete-extra-tags --convert-shn\line \line # Duplicate-folder cleanup\line  tlo-deleteDupes.cmd --TLOHome C:\\TLOHome E:\\Music\line \line # Research logs\line  tlo-research.exe --TLOHome C:\\TLOHome "Grateful Dead 1977-05-08"\line \line # Reverse logged folder operations\line  tlo-reverse.exe --TLOHome C:\\TLOHome --dry-run "E:\\Moved\\Grateful Dead 1977-05-08"\line  tlo-reverse.exe --TLOHome C:\\TLOHome "E:\\Moved\\Grateful Dead 1977-05-08"\line \line # Search\line  tlo-search.exe --TLOHome C:\\TLOHome --find "(Dylan |OR| The Band) |AND| 1974"}
